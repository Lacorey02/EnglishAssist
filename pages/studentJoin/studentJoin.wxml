<view class="page-shell {{themeClass}} page-shell--with-tab pre-entry-shell">
  <custom-nav title="加入班级" showBack="{{true}}" themeMode="{{themeMode}}" />
  <view class="pre-entry-main">
    <view class="section-block" style="margin-top: 0;">
      <view class="section-head pre-entry-title">
        <view class="section-title">加入班级</view>
      </view>
      <view class="section-card pre-entry-form-card">
        <view class="field-block">
          <text class="field-label">学生姓名</text>
          <input class="text-input" placeholder-class="input-placeholder" placeholder="请输入学生姓名" value="{{studentName}}" bindinput="onNameInput" />
        </view>
        <view class="field-block">
          <text class="field-label">班级代号</text>
          <input class="text-input" placeholder-class="input-placeholder" placeholder="请输入老师提供的班级代号" value="{{classCode}}" bindinput="onCodeInput" maxlength="8" />
        </view>
        <button class="primary-btn join-btn" bindtap="joinClass">确认加入</button>
      </view>
    </view>
  </view>
  <bottom-nav active="home" role="student" account-id="{{accountId}}" />
</view>
