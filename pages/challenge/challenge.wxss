.challenge-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 24rpx 36rpx;
}

.challenge-card {
  min-height: calc(100vh - 60rpx);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 42rpx 32rpx 34rpx;
}

.challenge-card .primary-btn,
.challenge-card .secondary-btn,
.challenge-card .warn-btn {
  width: 100%;
  min-height: 98rpx;
  border-radius: 18rpx;
  font-size: 34rpx;
}

.challenge-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.challenge-type {
  flex: 0 1 auto;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
}

.challenge-progress {
  flex: 0 0 auto;
  color: #65777e;
  font-size: 26rpx;
  font-weight: 700;
}

.challenge-progress-bar {
  width: 100%;
  height: 8rpx;
  margin-top: 22rpx;
  border-radius: 999rpx;
  background: rgba(23, 107, 135, 0.12);
  overflow: hidden;
}

.challenge-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(135deg, #176b87 0%, #2a9d8f 100%);
}

.challenge-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 0;
  padding: 28rpx 0;
}

.question-core {
  margin: 16rpx 0 26rpx;
}

.question-stem-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.question-stem-row .question-stem {
  min-width: 0;
  margin-top: 0;
}

.question-stem {
  padding: 6rpx 0 8rpx;
  font-size: 62rpx;
  font-weight: 800;
  line-height: 1.3;
  text-align: center;
  color: #17202a;
  word-break: break-word;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
}

.question-stem--meaning {
  font-size: 54rpx;
}

.question-stem--missing {
  font-size: 64rpx;
  letter-spacing: 8rpx;
}

.speaker-btn {
  flex: 0 0 60rpx;
  width: 60rpx;
  height: 60rpx;
  min-height: 60rpx;
  padding: 0;
  border-radius: 50%;
  background: #e7f3f0;
  color: #176b87;
  font-size: 32rpx;
  line-height: 60rpx;
}

.question-hint {
  margin-top: 18rpx;
  font-size: 30rpx;
  line-height: 1.45;
  color: #65777e;
  text-align: center;
}

.question-hint--primary {
  margin-top: 16rpx;
  font-size: 30rpx;
}

.challenge-interaction {
  margin-top: 20rpx;
}

.option-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-btn {
  min-height: 98rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  background: #f7faf8;
  color: #17202a;
  border: 1rpx solid rgba(80, 108, 106, 0.14);
  font-size: 34rpx;
  line-height: 1.4;
  text-align: left;
  transition: opacity 0.12s ease, transform 0.12s ease, background-color 0.12s ease;
}

.read-aloud-box,
.spell-box {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.read-aloud-guide {
  margin-top: 0;
  font-size: 32rpx;
}

.read-aloud-stats {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: rgba(231, 243, 240, 0.78);
  color: #40515a;
  font-size: 28rpx;
}

.read-aloud-box button[disabled] {
  opacity: 0.68;
}

.spell-box .text-input {
  min-height: 98rpx;
  font-size: 34rpx;
}

.feedback-box {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.task-actions {
  margin-top: auto;
}

.record-debug-box {
  margin-top: 6rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(247, 250, 248, 0.9);
}

.record-playback-btn {
  min-height: 58rpx;
  margin: 12rpx 0;
  padding: 0 18rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
}
