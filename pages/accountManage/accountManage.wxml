<view class="page-shell {{themeClass}} page-shell--with-tab" wx:if="{{account}}">
  <custom-nav title="账号管理" showBack="{{true}}" themeMode="{{themeMode}}" />
  <view class="hero-card">
    <view class="hero-badge">账号</view>
    <view class="hero-title">{{account.username}}</view>
    <view class="hero-desc">手机号：{{phoneLabel}}</view>
  </view>

  <view class="section-block">
    <view class="section-card">
      <view class="field-block">
        <text class="field-label">手机号</text>
        <input
          class="text-input"
          placeholder-class="input-placeholder"
          placeholder="请输入 11 位手机号"
          value="{{phone}}"
          bindinput="onPhoneInput"
          type="number"
          maxlength="11"
        />
      </view>
      <button class="primary-btn account-save-btn" bindtap="savePhone">保存手机号</button>
    </view>
  </view>

  <bottom-nav active="mine" role="{{role}}" class-id="{{classId}}" account-id="{{accountId}}" />
</view>

<view wx:else class="page-shell {{themeClass}}">
  <custom-nav title="账号管理" showBack="{{true}}" themeMode="{{themeMode}}" />
  <view class="section-card empty-state">
    <view class="empty-text">正在读取账号信息...</view>
  </view>
</view>
