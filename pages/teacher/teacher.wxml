<view class="page-shell {{themeClass}} page-shell--with-tab">
  <custom-nav title="我的班级" themeMode="{{themeMode}}" />
  <view class="hero-card teacher-home-hero">
    <view class="hero-badge">{{teacherProfile ? teacherProfile.name : "老师"}}</view>
    <view class="hero-title">我的班级</view>
    <view class="hero-desc">创建或加入班级后，可以查看学生词汇打卡进度。</view>
    <view class="hero-meta-row">
      <view class="hero-metric">
        <view class="hero-metric__value">{{classes.length}}</view>
        <view class="hero-metric__label">我的班级</view>
      </view>
      <view class="hero-metric">
        <view class="hero-metric__value">打卡</view>
        <view class="hero-metric__label">发布任务与查看报告</view>
      </view>
    </view>
    <view class="class-action-row teacher-home-action-row">
      <button class="secondary-btn action-btn teacher-home-create" bindtap="goCreateClass">新建班级</button>
      <button class="secondary-btn action-btn teacher-home-create" bindtap="goJoinClass">加入班级</button>
    </view>
  </view>

  <view class="section-block">
    <view class="section-head">
      <view class="section-title">班级列表</view>
      <view class="tag">{{classes.length}} 个</view>
    </view>

    <view wx:if="{{classes.length}}">
      <view wx:for="{{classes}}" wx:key="id" class="task-card" hover-class="pressable-hover" data-class-id="{{item.id}}" bindtap="openClass">
        <view class="task-head">
          <view class="task-title">{{item.name}}</view>
          <view class="tag">{{item.roleLabel}}</view>
        </view>
        <view class="task-meta">班级代号：{{item.code}}</view>
        <view class="task-meta">创建老师：{{item.teacherName}} · 学生 {{item.studentCount}} 人</view>
      </view>
    </view>

    <view wx:else class="section-card empty-state teacher-home-empty">
      <view class="empty-text">还没有创建或加入班级</view>
    </view>
  </view>

  <bottom-nav active="home" role="teacher" class-id="{{classId}}" account-id="{{accountId}}" />
</view>
