.hero-card .primary-btn {
  width: 100%;
}

.class-role-tag {
  margin-top: 18rpx;
}

.task-card-tag-row {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  flex-wrap: wrap;
}

.task-card-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  max-width: 100%;
  margin-top: 28rpx;
  box-sizing: border-box;
}

.task-action {
  height: 76rpx;
  min-height: 76rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}

.task-action-primary {
  flex: 1;
  min-width: 0;
}

.task-action-danger {
  flex: 0 0 150rpx;
  width: 150rpx;
  background: #fff1e9;
  color: #c85c4f;
  border: 1rpx solid rgba(200, 92, 79, 0.28);
}
