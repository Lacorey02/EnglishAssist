.manage-class-card {
  padding: 24rpx;
  margin-top: 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 28rpx rgba(23, 32, 42, 0.08);
  border: 1rpx solid rgba(80, 108, 106, 0.12);
  border-left: 6rpx solid #2a9d8f;
}

.class-manage-top-btn {
  margin: 0;
}

.class-manage-top-actions {
  margin-top: 28rpx;
}

.join-class-strip {
  width: 100%;
  height: 96rpx;
  min-height: 96rpx;
  margin: 0;
  display: flex;
  box-sizing: border-box;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.class-manage-list-block .manage-class-card:first-child {
  margin-top: 0;
}

.manage-class-card .task-actions {
  display: flex;
  gap: 14rpx;
  width: 100%;
  box-sizing: border-box;
}

.manage-class-card .task-actions--single {
  justify-content: center;
}

.manage-class-card .task-actions button {
  flex: 1;
  min-width: 0;
  width: auto;
  box-sizing: border-box;
  padding-left: 14rpx;
  padding-right: 14rpx;
}

.manage-class-card .task-actions--single button {
  flex: none;
  width: 100%;
}

.leave-class-wide-btn {
  max-width: 560rpx;
}
