.bottom-nav {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: 24rpx;
  z-index: 20;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  padding: 10rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 42rpx rgba(23, 32, 42, 0.14);
  border: 1rpx solid rgba(80, 108, 106, 0.14);
}

.bottom-nav__item {
  min-height: 82rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  color: #65777e;
  font-size: 22rpx;
  font-weight: 700;
}

.bottom-nav__item--active {
  background: #e7f3f0;
  color: #176b87;
}

.bottom-nav__icon {
  font-size: 30rpx;
  line-height: 1;
}

.bottom-nav.theme-dark {
  background: rgba(24, 34, 39, 0.96);
  border-color: rgba(139, 169, 165, 0.18);
  box-shadow: 0 18rpx 42rpx rgba(0, 0, 0, 0.32);
}

.bottom-nav.theme-dark .bottom-nav__item {
  color: #9fb0b3;
}

.bottom-nav.theme-dark .bottom-nav__item--active {
  background: rgba(59, 191, 174, 0.14);
  color: #8fe0d2;
}
